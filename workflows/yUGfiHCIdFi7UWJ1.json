    {
      "parameters": {
        "jsCode": "const messages = $input.all();\n\nif (messages.length === 0) {\n  return [];\n}\n\nconst emailBody = messages\n  .map((item, index) => {\n    const m = item.json;\n\n    const date = m.created_at\n      ? new Date(m.created_at).toLocaleString('en-US', {\n          dateStyle: 'medium',\n          timeStyle: 'short',\n        })\n      : 'Unknown';\n\n    return `\n--------------------------------\nMESSAGE ${index + 1}\n\nName: ${m.name}\n\nMessage:\n${m.message}\n\nReceived: ${new Date(date).toLocaleString('en-US', {\n            timeZone: 'America/Los_Angeles',\n          dateStyle: 'medium',\n          timeStyle: 'short',\n        })}\n`;\n  })\n  .join('\\n');\n\nreturn [\n  {\n    json: {\n      messageCount: messages.length,\n      emailBody,\n      messageIds: messages.map((item) => item.json.id),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -144
      ],
      "id": "a43475d2-3fff-4eef-9e8a-f76bb2b12181",
      "name": "Code – Combine Messages"
    },
    {
      "parameters": {
        "jsCode": "const ids = $('Code – Combine Messages').first().json.messageIds;\n\nreturn ids.map((id) => ({\n  json: {\n    id,\n    notification_sent: true,\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
