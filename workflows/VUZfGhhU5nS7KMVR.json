      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  if (item.binary?.data) {\n    item.binary.data.mimeType = 'image/jpeg';\n    item.binary.data.fileExtension = 'jpg';\n    item.binary.data.fileName = 'street-camera.jpg';\n  }\n}\n\nreturn $input.all();"
